{
  "name": "Default Linux Universal",
  "build": {
    "dockerfile": "../Dockerfile"
  },
  "forwardPorts": [3000, 5000],
  "portsAttributes": {
    "3000": { "label": "Next.js Frontend" },
    "5000": { "label": "Express Backend" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "remoteUser": "codespace"
}